    border-radius:999px;
    border:1px solid rgba(184,137,43,0.25);
  }
  .modebar button{
    font-family:'Cinzel',serif;
    font-size:13px;
    letter-spacing:0.03em;
    padding:9px 20px;
    border-radius:999px;
    border:none;
    background:transparent;
    color:var(--plaster-dim);
    cursor:pointer;
    transition:background .2s, color .2s;
  }
  .modebar button.active{
    background:var(--gold);
    color:var(--stone);
  }
  .stage{
    width:100%;
    max-width:560px;
  }
  .progress{
    display:flex;
    align-items:center;
    justify-content:space-between;
    margin-bottom:14px;
    font-size:13px;
    color:var(--plaster-dim);
