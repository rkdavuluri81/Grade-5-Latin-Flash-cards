btnQuiz.addEventListener('click', () => {
  setActiveTab(btnQuiz);
  quizView.style.display = '';
  let n = 'Player';
  try{ n = localStorage.getItem(NAME_KEY) || 'Player'; }catch(e){}
  document.getElementById('player-name-display').textContent = n;
});
btnScores.addEventListener('click', () => { setActiveTab(btnScores); scoresView.style.display = ''; renderScoreboard(); });
</script>

