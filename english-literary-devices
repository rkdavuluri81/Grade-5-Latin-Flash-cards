<script>
/* ---------- CONTENT (from the handout) ---------- */
const PART_LABEL = {
  char:'Part 1 · Characterization',
  fore:'Part 2 · Foreshadowing',
  amb:'Part 3 · Ambiguity',
  mix:'All three devices'
};

const cards = [
  {part:'char', term:'Characterization', def:'The way an author reveals the personality of a character. Readers learn what drives a character: their motivations, flaws, strengths, and how they change throughout a story.'},
  {part:'char', term:'Showing vs. telling', def:'Effective characterization isn’t just about telling us what a character is like; it’s about showing us through their actions, speech, thoughts, and how other characters react to them.'},
  {part:'char', term:'Direct characterization', def:'The author explicitly tells the reader about a character’s personality. It’s straightforward.\n\nExample: “Old Man Tiber was a grumpy, solitary figure, known throughout the village for his harsh words and unwillingness to help others.”'},
  {part:'char', term:'Indirect characterization', def:'More subtle. Instead of telling the reader what a character is like, the author shows us through five main methods, often remembered with the acronym STEAL.'},
  {part:'char', term:'STEAL', def:'Speech, Thoughts, Effect on others, Actions, Looks. The five methods of indirect characterization.'},
  {part:'char', term:'S: Speech', def:'What does the character say and how do they say it?'},
  {part:'char', term:'T: Thoughts', def:'What is revealed through the character’s inner thoughts and feelings?'},
  {part:'char', term:'E: Effect on others', def:'How do other characters react to this character?'},
  {part:'char', term:'A: Actions', def:'What does the character do? How do they behave?'},
  {part:'char', term:'L: Looks', def:'What does the character look like? What is their appearance?'},
  {part:'fore', term:'Foreshadowing', def:'A literary device in which an author gives a hint of events that will occur later in the story.'},
  {part:'fore', term:'Foreshadowing as seeds', def:'Think of it as planting important seeds of information that become important plot points. It doesn’t exactly reveal the future; it provides clues or signals of points to come.'},
  {part:'amb', term:'Ambiguity', def:'Something is open to more than one interpretation. Think of a puzzle where the pieces could fit together in a few different ways. It isn’t necessarily a mistake; sometimes ambiguity is intentional, used to create a special effect.'},
  {part:'amb', term:'Why authors use ambiguity', def:'One reason is to build tension and keep the audience in a state of suspense or intrigue.'}
];

// a = the correct answer, w = three wrong answers, why = shown after answering
const questions = [
  // Part 1: Characterization
  {part:'char', q:'What is characterization?',
   a:'The way an author reveals the personality of a character',
   w:['A hint of events that will occur later in the story','Something that is open to more than one interpretation','The place and time where a story happens'],
   why:'Characterization is the way an author reveals the personality of a character.'},
  {part:'char', q:'Through characterization, readers learn about a character’s…',
   a:'motivations, flaws, strengths, and how they change throughout a story',
   w:['only what the character looks like','what will happen at the end of the story','the title of the story'],
   why:'Readers learn what drives a character: motivations, flaws, strengths, and how they change.'},
  {part:'char', q:'Effective characterization is mostly about…',
   a:'showing us a character through actions, speech, thoughts, and how others react',
   w:['telling us exactly what a character is like','describing the setting in great detail','hiding who the character is until the end'],
   why:'It isn’t just about telling; it’s about showing us.'},
  {part:'char', q:'How many forms of characterization are there?',
   a:'Two',
   w:['Three','Five','Seven'],
   why:'There are two forms: direct and indirect characterization.'},
  {part:'char', q:'Direct characterization is when the author…',
   a:'explicitly tells the reader about a character’s personality',
   w:['shows the character only through how other characters react','gives a hint of an event that will happen later','leaves the character open to more than one interpretation'],
   why:'Direct characterization is when the author explicitly tells the reader. It’s straightforward.'},
  {part:'char', q:'“Old Man Tiber was a grumpy, solitary figure, known throughout the village for his harsh words and unwillingness to help others.” This is an example of…',
   a:'direct characterization',
   w:['indirect characterization','foreshadowing','ambiguity'],
   why:'The author tells us outright that he is grumpy and solitary, so it is direct characterization.'},
  {part:'char', q:'In indirect characterization, the author…',
   a:'shows us what a character is like through five main methods',
   w:['tells us outright what the character is like','uses only one method','skips describing the character'],
   why:'Indirect characterization is more subtle: the author shows us through five main methods.'},
  {part:'char', q:'Which acronym helps you remember the methods of indirect characterization?',
   a:'STEAL',
   w:['SHOW','TELL','PLOT'],
   why:'STEAL: Speech, Thoughts, Effect on others, Actions, Looks.'},
  {part:'char', q:'In STEAL, what does the “E” stand for?',
   a:'Effect on others',
   w:['Emotions','Events','Examples'],
   why:'E is Effect on others: how do other characters react to this character?'},
  {part:'char', q:'In STEAL, what does the “L” stand for?',
   a:'Looks',
   w:['Language','Lessons','Lines'],
   why:'L is Looks: what does the character look like? What is their appearance?'},
  {part:'char', q:'Which one is NOT one of the five STEAL methods?',
   a:'Setting',
   w:['Speech','Thoughts','Actions'],
   why:'The five methods are Speech, Thoughts, Effect on others, Actions, and Looks. Setting is not one of them.'},
  {part:'char', q:'A character slams the door and refuses to help a neighbor. Which STEAL method is this?',
   a:'Actions',
   w:['Speech','Looks','Thoughts'],
   why:'Actions asks: what does the character do? How do they behave?'},
  {part:'char', q:'Everyone in the room goes quiet and moves away when Mia walks in. Which STEAL method is this?',
   a:'Effect on others',
   w:['Speech','Looks','Thoughts'],
   why:'How other characters react to Mia shows her effect on others.'},
  {part:'char', q:'A story shares what a character secretly feels inside her own mind. Which STEAL method is this?',
   a:'Thoughts',
   w:['Speech','Actions','Looks'],
   why:'Thoughts are revealed through the character’s inner thoughts and feelings.'},

  // Part 2: Foreshadowing
  {part:'fore', q:'What is foreshadowing?',
   a:'A hint of events that will occur later in the story',
   w:['The way an author reveals a character’s personality','Something that is open to more than one interpretation','A summary of the whole plot at the start'],
   why:'Foreshadowing is a literary device in which an author gives a hint of events that will occur later.'},
  {part:'fore', q:'Foreshadowing can be viewed as when you…',
   a:'plant important seeds of information that become important plot points',
   w:['tell the reader the ending right away','describe a character’s appearance','leave a mistake in the story'],
   why:'It is like planting seeds of information that later become important plot points.'},
  {part:'fore', q:'Does foreshadowing exactly reveal the future?',
   a:'No, it provides clues or signals of points to come',
   w:['Yes, it states exactly what will happen','Yes, it always gives away the ending','No, it is always a mistake'],
   why:'Foreshadowing doesn’t exactly reveal the future; it provides clues or signals of points to come.'},
  {part:'fore', q:'Early in a story, a character notices a crack in an old bridge. Later, the bridge collapses. The crack is an example of…',
   a:'foreshadowing',
   w:['direct characterization','ambiguity','speech'],
   why:'The crack is a clue planted early that points to an event later in the story.'},

  // Part 3: Ambiguity
  {part:'amb', q:'Ambiguity means something is…',
   a:'open to more than one interpretation',
   w:['a hint of events that will occur later','the way an author reveals personality','always spelled wrong'],
   why:'Essentially, ambiguity means something is open to more than one interpretation.'},
  {part:'amb', q:'The handout compares ambiguity to…',
   a:'a puzzle where the pieces could fit together in a few different ways',
   w:['a map with one clear route','a recipe with exact steps','a mirror that shows only one image'],
   why:'Think of it like a puzzle where the pieces could fit together in a few different ways.'},
  {part:'amb', q:'Is ambiguity necessarily a mistake?',
   a:'No, sometimes it is intentional, used to create a special effect',
   w:['Yes, authors never do it on purpose','Yes, it means the story is unfinished','No, it only appears in poems'],
   why:'It isn’t necessarily a mistake. Sometimes ambiguity is intentional, used to create a special effect.'},
  {part:'amb', q:'One reason an author uses ambiguity is to…',
   a:'build tension and keep the audience in suspense or intrigue',
   w:['tell the reader exactly what a character is like','reveal the ending early','make the story shorter'],
   why:'Ambiguity can build tension and keep its audience in a state of suspense or intrigue.'},

  // Mixed
  {part:'mix', q:'Which literary device gives hints about events that will happen later in the story?',
   a:'Foreshadowing',
   w:['Characterization','Ambiguity','STEAL'],
   why:'Foreshadowing gives hints of later events.'},
  {part:'mix', q:'Which literary device means something is open to more than one interpretation?',
   a:'Ambiguity',
   w:['Foreshadowing','Characterization','Direct characterization'],
   why:'Ambiguity is open to more than one interpretation.'},
  {part:'mix', q:'Showing a character through speech, thoughts, effect on others, actions, and looks is called…',
   a:'indirect characterization',
   w:['direct characterization','foreshadowing','ambiguity'],
   why:'Those five methods (STEAL) make up indirect characterization.'}
];

/* ---------- HELPERS ---------- */
function shuffle(arr){
  const a = arr.slice();
  for(let i=a.length-1;i>0;i--){
    const j = Math.floor(Math.random()*(i+1));
    [a[i],a[j]] = [a[j],a[i]];
  }
  return a;
}
function escapeHtml(str){
  const div = document.createElement('div');
  div.textContent = str;
  return div.innerHTML;
}
document.getElementById('header-sub').textContent =
  cards.length + ' study cards · ' + questions.length + ' quiz questions';

/* ---------- STUDY CARDS ---------- */
let deck = cards.slice();
let idx = 0, flipped = false;
const cardEl = document.getElementById('card');

function renderCard(){
  const c = deck[idx];
  document.getElementById('front-text').textContent = c.term;
  document.getElementById('back-text').textContent = c.def;
  document.getElementById('face-part').textContent = PART_LABEL[c.part];
  document.getElementById('back-part').textContent = PART_LABEL[c.part];
  document.getElementById('flash-count').textContent = (idx+1) + ' / ' + deck.length;
  document.getElementById('flash-fill').style.width = (((idx+1)/deck.length)*100) + '%';
  flipped = false;
  cardEl.classList.remove('flipped');
}
// snap back to the front before swapping text so the next answer never flashes
function goToCard(n){
  if(flipped){
    cardEl.classList.add('no-transition');
    cardEl.classList.remove('flipped');
    flipped = false;
    void cardEl.offsetWidth;
    idx = n; renderCard();
    void cardEl.offsetWidth;
    cardEl.classList.remove('no-transition');
  } else { idx = n; renderCard(); }
}
function toggleFlip(){ flipped = !flipped; cardEl.classList.toggle('flipped', flipped); }
document.getElementById('card-wrap').addEventListener('click', toggleFlip);
document.getElementById('flip-btn').addEventListener('click', e => { e.stopPropagation(); toggleFlip(); });
document.getElementById('next-btn').addEventListener('click', () => goToCard((idx+1)%deck.length));
document.getElementById('prev-btn').addEventListener('click', () => goToCard((idx-1+deck.length)%deck.length));
document.getElementById('shuffle-btn').addEventListener('click', () => { deck = shuffle(deck); goToCard(0); });
renderCard();

/* ---------- SCOREBOARD STORAGE ---------- */
const SCORE_KEY = 'latin-scores-english1';
const NAME_KEY = 'latin-player-name';

function getPlayerName(){
  let name = null;
  try{ name = localStorage.getItem(NAME_KEY); }catch(e){}
  if(!name){
    name = (prompt('What\'s your name? (shown on the scoreboard)') || 'Player').trim().slice(0,24) || 'Player';
    try{ localStorage.setItem(NAME_KEY, name); }catch(e){}
  }
  return name;
}
function setPlayerName(){
  let current = '';
  try{ current = localStorage.getItem(NAME_KEY) || ''; }catch(e){}
  const name = (prompt('Enter your name for the scoreboard:', current) || current || 'Player').trim().slice(0,24) || 'Player';
  try{ localStorage.setItem(NAME_KEY, name); }catch(e){}
  document.getElementById('player-name-display').textContent = name;
}
function loadScores(){
  try{ return JSON.parse(localStorage.getItem(SCORE_KEY) || '[]'); }catch(e){ return []; }
}
function saveScore(name, correct, total, percent, mode){
  const scores = loadScores();
  const now = new Date();
  scores.push({
    name, correct, total, percent, mode,
    ts: now.getTime(),
    date: now.toLocaleDateString(),
    time: now.toLocaleTimeString([], {hour:'2-digit', minute:'2-digit'})
  });
  while(scores.length > 50) scores.shift();
  try{ localStorage.setItem(SCORE_KEY, JSON.stringify(scores)); }catch(e){}
}
const MODE_LABEL = {all:'Everything', char:'Characterization', fore:'Foreshadowing', amb:'Ambiguity'};
function renderScoreboard(){
  const content = document.getElementById('scores-content');
  const scores = loadScores();
  if(scores.length === 0){
    content.innerHTML = '<div class="score-empty">No quiz attempts logged yet on this device.<br>Finish a quiz to appear here.</div>';
    return;
  }
  const sorted = scores.slice().sort((a,b) => b.percent - a.percent || (b.ts||0) - (a.ts||0));
  let current = '';
  try{ current = localStorage.getItem(NAME_KEY) || ''; }catch(e){}
  const rows = sorted.slice(0,20).map(s => (
    '<tr class="' + (s.name === current ? 'you' : '') + '">' +
      '<td>' + escapeHtml(s.name) + '</td>' +
      '<td>' + s.correct + ' / ' + s.total + '</td>' +
      '<td class="score-percent">' + s.percent + '%</td>' +
      '<td>' + escapeHtml(MODE_LABEL[s.mode] || '') + '</td>' +
      '<td>' + s.date + '</td>' +
      '<td>' + (s.time || '&mdash;') + '</td>' +
    '</tr>'
  )).join('');
  content.innerHTML =
    '<table class="score-table"><thead><tr>' +
    '<th>Name</th><th>Score</th><th>%</th><th>Quiz</th><th>Date</th><th>Time</th>' +
    '</tr></thead><tbody>' + rows + '</tbody></table>';
}

/* ---------- QUIZ ---------- */
let qDeck = [], qIdx = 0, qCorrect = 0, qAnswered = 0, qMode = 'all', qLocked = false, qMissed = [];
const setupEl = document.getElementById('quiz-setup');
const playEl = document.getElementById('quiz-play');
const doneEl = document.getElementById('quiz-done');
const optionsEl = document.getElementById('options');
const feedbackEl = document.getElementById('quiz-feedback');
const nextBtn = document.getElementById('quiz-next');

function questionsFor(mode){
  return mode === 'all' ? questions.slice() : questions.filter(q => q.part === mode);
}
// build the quiz menu from the data so the counts are always right
(function buildMenu(){
  const list = document.getElementById('mode-list');
  [['all','Everything'],['char','Part 1: Characterization'],['fore','Part 2: Foreshadowing'],['amb','Part 3: Ambiguity']].forEach((m,i) => {
    const b = document.createElement('button');
    b.className = 'mode-pick' + (i === 0 ? ' primary-pick' : '');
    b.textContent = m[1] + ' — ' + questionsFor(m[0]).length + ' questions';
    b.addEventListener('click', () => { getPlayerName(); startQuiz(m[0]); });
    list.appendChild(b);
  });
})();

function startQuiz(mode){
  qMode = mode;
  qDeck = shuffle(questionsFor(mode));
  qIdx = 0; qCorrect = 0; qAnswered = 0; qMissed = [];
  setupEl.style.display = 'none';
  doneEl.style.display = 'none';
  playEl.style.display = '';
  document.getElementById('quiz-score').textContent = 'Score: 0 correct / 0 answered';
  document.getElementById('player-name-display').textContent = getPlayerName();
  renderQuestion();
}
function renderQuestion(){
  const q = qDeck[qIdx];
  document.getElementById('quiz-part').textContent = PART_LABEL[q.part];
  document.getElementById('quiz-q').textContent = q.q;
  document.getElementById('quiz-count').textContent = (qIdx+1) + ' / ' + qDeck.length;
  document.getElementById('quiz-fill').style.width = (((qIdx+1)/qDeck.length)*100) + '%';
  feedbackEl.textContent = '';
  feedbackEl.className = 'feedback';
  nextBtn.style.display = 'none';
  optionsEl.innerHTML = '';
  qLocked = false;
  shuffle([q.a].concat(q.w)).forEach((text, i) => {
    const b = document.createElement('button');
    b.className = 'opt';
    b.setAttribute('data-text', text);
    b.innerHTML = '<span class="key">' + 'ABCD'[i] + '</span> ' + escapeHtml(text);
    b.addEventListener('click', () => choose(b));
    optionsEl.appendChild(b);
  });
}
function choose(btn){
  if(qLocked) return;
  qLocked = true;
  const q = qDeck[qIdx];
  const picked = btn.getAttribute('data-text');
  const ok = picked === q.a;
  qAnswered++;
  Array.prototype.forEach.call(optionsEl.children, b => {
    b.disabled = true;
    if(b.getAttribute('data-text') === q.a) b.classList.add('right');
  });
  if(ok){
    qCorrect++;
    feedbackEl.textContent = 'Correct! ' + q.why;
    feedbackEl.className = 'feedback correct';
  } else {
    btn.classList.add('wrong');
    qMissed.push(q);
    feedbackEl.textContent = 'Not quite. ' + q.why;
    feedbackEl.className = 'feedback wrong';
  }
  document.getElementById('quiz-score').textContent = 'Score: ' + qCorrect + ' correct / ' + qAnswered + ' answered';
  nextBtn.textContent = qIdx + 1 >= qDeck.length ? 'See results' : 'Next';
  nextBtn.style.display = '';
  nextBtn.focus();
}
nextBtn.addEventListener('click', () => {
  if(!qLocked) return;          // ignore clicks before an answer is chosen
  qLocked = false;
  qIdx++;
  if(qIdx >= qDeck.length){ finishQuiz(); return; }
  renderQuestion();
});
// keys 1-4 or A-D pick an answer; Enter moves on
document.addEventListener('keydown', e => {
  if(playEl.style.display === 'none' || quizView.style.display === 'none') return;
  if(e.key === 'Enter' && qLocked){
    // preventDefault stops the focused Next button from also firing its own
    // click, which would skip a question
    e.preventDefault();
    nextBtn.click();
    return;
  }
  const k = '1234abcd'.indexOf(e.key.toLowerCase());
  if(k !== -1 && !qLocked){
    const b = optionsEl.children[k % 4];
    if(b) b.click();
  }
});
function scoreMessage(p){
  if(p >= 100) return {title:'Perfect score!', msg:'Every answer correct. You really know these literary devices.'};
  if(p >= 90)  return {title:'Excellent work!', msg:'Nearly flawless. Just a detail or two to polish.'};
  if(p >= 80)  return {title:'Great job!', msg:'Solid understanding. Review the ones you missed and you will have them locked in.'};
  if(p >= 70)  return {title:'Good effort!', msg:'You are on the right track. A bit more practice and these will stick.'};
  return {title:'Keep practicing!', msg:'Go back through the study cards, then try the quiz again. You will improve fast.'};
}
function finishQuiz(){
  const percent = Math.round((qCorrect / qDeck.length) * 100);
  saveScore(getPlayerName(), qCorrect, qDeck.length, percent, qMode);
  const m = scoreMessage(percent);
  playEl.style.display = 'none';
  doneEl.style.display = '';
  document.getElementById('done-percent').textContent = percent + '% correct (' + qCorrect + ' of ' + qDeck.length + ')';
  document.getElementById('done-title').textContent = m.title;
  document.getElementById('done-msg').textContent = m.msg;
  const missedEl = document.getElementById('done-missed');
  if(qMissed.length){
    missedEl.innerHTML = '<strong style="color:var(--gold-bright);">Review these:</strong>' +
      '<ul style="margin:8px 0 0;padding-left:20px;line-height:1.6;">' +
      qMissed.map(q => '<li>' + escapeHtml(q.q) + '<br><em>' + escapeHtml(q.a) + '</em></li>').join('') +
      '</ul>';
  } else { missedEl.innerHTML = ''; }
}
document.getElementById('done-restart').addEventListener('click', () => startQuiz(qMode));
document.getElementById('done-menu').addEventListener('click', () => {
  doneEl.style.display = 'none'; playEl.style.display = 'none'; setupEl.style.display = '';
});
document.getElementById('change-name-btn').addEventListener('click', setPlayerName);

