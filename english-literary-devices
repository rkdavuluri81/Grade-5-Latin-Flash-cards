    perspective:1400px;
    height:280px;
    margin-bottom:22px;
    cursor:pointer;
  }
  .card{
    position:relative;
    width:100%;
    height:100%;
    transform-style:preserve-3d;
    transition:transform .5s cubic-bezier(.4,.2,.2,1);
  }
  .card.flipped{ transform:rotateY(180deg); }
  .card.no-transition{ transition:none !important; }
  .face{
    position:absolute;
    inset:0;
    backface-visibility:hidden;
    border-radius:6px;
    display:flex;
    flex-direction:column;
    align-items:center;
    justify-content:center;
    text-align:center;
    padding:32px;
    border:1px solid rgba(184,137,43,0.3);
  }
  .face.front{
    background:linear-gradient(160deg, var(--stone-light), var(--stone));
    box-shadow: inset 0 0 0 1px rgba(236,228,211,0.04), 0 10px 30px rgba(0,0,0,0.35);
  }
  .face.back{
    background:linear-gradient(160deg, var(--wine-bright), var(--wine));
    transform:rotateY(180deg);
    box-shadow: 0 10px 30px rgba(0,0,0,0.35);
  }
  .card-num{
    font-family:'Cinzel',serif;
    font-size:12px;
    letter-spacing:0.1em;
    color:var(--gold-bright);
    position:absolute;
    top:16px;
    left:20px;
  }
  .latin{
    font-family:'Cinzel',serif;
    font-weight:700;
    font-size:clamp(22px,5vw,30px);
    color:var(--plaster);
    line-height:1.3;
  }
  .hint{
    margin-top:14px;
    font-size:12px;
    color:var(--plaster-dim);
    letter-spacing:0.05em;
  }
  .pron{
    font-family:'Source Serif 4',serif;
    font-style:italic;
    font-size:14px;
    color:var(--gold-bright);
    margin-top:8px;
  }
  .speak-btn{
    background:none;
    border:1px solid rgba(184,137,43,0.4);
    color:var(--gold-bright);
    width:34px;
    height:34px;
    border-radius:50%;
    cursor:pointer;
    font-size:15px;
    display:inline-flex;
    align-items:center;
    justify-content:center;
    margin-top:12px;
