<style>
  :root{
    --stone: #2b2620;
    --stone-light: #3c352c;
    --gold: #b8892b;
    --gold-bright: #d9a840;
    --plaster: #ece4d3;
    --plaster-dim: #c9beaa;
    --wine: #7a2e2e;
    --wine-bright: #a8433f;
    --green: #4f6b4a;
  }
  *{box-sizing:border-box;}
  body{
    margin:0;
    min-height:100vh;
    background:
      radial-gradient(ellipse at 20% 0%, rgba(184,137,43,0.08), transparent 60%),
      var(--stone);
    color:var(--plaster);
    font-family:'Source Serif 4', serif;
    display:flex;
    flex-direction:column;
    align-items:center;
    padding:32px 20px 60px;
