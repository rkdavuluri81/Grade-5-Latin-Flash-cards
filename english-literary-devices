  header{
    text-align:center;
    max-width:640px;
    margin-bottom:28px;
  }
  .kicker{
    font-family:'Cinzel',serif;
    font-size:13px;
    letter-spacing:0.12em;
    color:var(--gold-bright);
    margin:0 0 6px;
  }
  h1{
    font-family:'Cinzel',serif;
    font-weight:700;
    font-size:clamp(24px,4vw,34px);
    margin:0 0 8px;
